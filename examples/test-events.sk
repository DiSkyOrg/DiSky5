# ============================================================================
#  DiSky V5 — ALL EVENTS test script  (auto-generated)
#
#  HOW TO USE
#  1. Put your Discord bot token in the `define bot` below.
#  2. Copy this file into  plugins/Skript/scripts/  on a Paper server that has
#     Skript 2.15.2 + the DiSky5 plugin jar.
#  3. /sk reload test-events  — every event block should LOAD WITH NO PARSE
#     ERRORS (that alone tests that all events + their values parse).
#  4. Connect the bot, then trigger events on Discord: each fires writeDebug()
#     which prints to the console.
#
#  writeDebug() currently sends to console; later, swap the body for a
#  write-to-file (the TODO line below).
# ============================================================================

function writeDebug(event: text, data: text):
    send "&8[&bDiSky-evt&8] &e%{_event}%&7 -> %{_data}%" to console
    # TODO (later): write "[%now%] %{_event}%: %{_data}%%nl%" to file "plugins/DiSky/event-test.log"

define bot named "test-bot":
    token: "PUT-YOUR-BOT-TOKEN-HERE"
    intents: default intents

# Lifecycle is a global event in V5, no longer a section of 'define bot'.
on ready seen by "test-bot":
    send "[DiSky] &aEvent-test bot connected as %name of event-bot%." to console

# ============================================================================
#  EVENTS  (one block per DiSky event, grouped by domain)
# ============================================================================

# ===== bot =====

on bot guild joined:
    writeDebug("Bot Join Event", "bot=%event-bot% guild=%event-guild%")

on bot guild leave:
    writeDebug("Bot Leave Event", "bot=%event-bot% guild=%event-guild%")

on bot shutdown:
    writeDebug("Bot Shutdown Event", "bot=%event-bot%")

on guild ready:
    writeDebug("Guild Ready Event", "bot=%event-bot% guild=%event-guild%")

on ready:
    writeDebug("Bot Ready Event", "bot=%event-bot%")


